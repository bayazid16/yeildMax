# ============================================================
# YieldMax-AI — root .gitignore
# Applies to the whole repository (backend, frontend, scripts).
# ============================================================

# ------------------------------------------------------------
# Environment / secrets (never commit real values)
# ------------------------------------------------------------
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
.envrc
*.env
!*.env.example
secrets.toml
*.pem
*.key
id_rsa*

