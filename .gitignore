frontend_agent_backup/
*_backup/
*~backup*/

# ------------------------------------------------------------
# Docker / deployment artifacts
# Dockerfile, docker/ and .dockerignore stay tracked.
# docker-compose files are local-only and must not be pushed.
# ------------------------------------------------------------
.docker/
docker-compose.yml
docker-compose.yaml
docker-compose*.yml
docker-compose*.yaml
*.dockerignore.bak
.dockerenv
containerd.sock
*.tar
!public/*.tar
.vercel/
.now/
.netlify/

