# ============================================================
# YieldMax V2 - Environment Configuration (.env.example)
# Safe defaults using ${VAR:-default} syntax in docker-compose.yml
# Copy this to .env and fill in your values.
# ============================================================

# ============================================================
# Database Configuration
# ============================================================
# PostgreSQL connection settings used by Django ORM
DB_NAME=yieldmax_db
DB_USER=yieldmax_user
DB_PASSWORD=yieldmax_pass
DB_HOST=db
DB_PORT=5432

# ============================================================
# Django Settings
# ============================================================
# Django secret key - change for production!
SECRET_KEY=django-insecure-+1pe*olh+ez8d*&(_z-(d)5_u993tuz4mz_gwg%d0($
# Debug mode - disable in production
DEBUG=True
# Allowed hosts - expand for production deployment
ALLOWED_HOSTS=*

# ============================================================
# Redis / Celery Configuration (V2)
# ============================================================
# Redis is used as the Celery message broker and result backend.
# Change to your production Redis URL in production.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ============================================================
# LLM Provider Configuration (Optional)
# ============================================================
# If both OPENAI_API_KEY and GEMINI_API_KEY are left empty,
# the application will seamlessly return a Bengali fallback
# message instead of crashing. This is by design.
OPENAI_API_KEY=
GEMINI_API_KEY=

# LLM configuration
LLM_TIMEOUT_SECONDS=30
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_MODEL=gpt-3.5-turbo

# ============================================================
# Satellite Imagery (Optional - V2)
# ============================================================
# Set these to enable real Sentinel Hub satellite data.
# Without them, the app shows honest prototype NDVI data.
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# ============================================================
# Frontend Configuration
# ============================================================
# Leave VITE_API_BASE_URL empty so all /api/ calls go through nginx proxy
# (avoids CORS). Only set this for local Vite dev server without docker.
VITE_API_BASE_URL=
